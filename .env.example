# -----------------------------------------------------------------------------
# BookHaven Marketplace Environment Variables
# -----------------------------------------------------------------------------

# Supabase Project Credentials (from Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Supabase Storage Bucket Name (Create as PUBLIC bucket in Supabase dashboard)
SUPABASE_STORAGE_BUCKET=bookhaven

# Cryptographic Secret for Anti-Bot CAPTCHA HMAC tokens (Any random secure string)
CAPTCHA_SECRET=bookhaven-anti-bot-key-change-in-production

# Server Port (Only used for local standalone development)
PORT=5000

# Client Origin (Optional, for CORS when frontend and backend run on different domains)
# CLIENT_ORIGIN=https://your-bookhaven.vercel.app
